# ---- Data source (server-only) ----
# mock = built-in demo data (default). http = forward every /api/* call to a real backend.
KERF_DATA_SOURCE=mock
# Base URL of the backend that serves /api/markets, /api/routes, /api/quote, ... (see /docs#developers).
# Must NOT point at this app itself.
KERF_API_BASE_URL=
# Optional bearer token sent to the backend. Never exposed to the browser.
KERF_API_KEY=
# RPC provider URL for the backend / future server-side reads (the public RPC is rate-limited).
KERF_RPC_URL=

# ---- Public (bundled into the browser) ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_EXPLORER_URL=https://robinhoodchain.blockscout.com
NEXT_PUBLIC_X_HANDLE=kerfbench
# Deployed KerfExecutor address, used once real transaction sending replaces the demo in src/lib/execution.ts.
NEXT_PUBLIC_EXECUTOR_ADDRESS=
# $KERF contract address, once the token is launched (e.g. via a launchpad). Empty = "soon".
NEXT_PUBLIC_TOKEN_ADDRESS=
