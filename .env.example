# ---- Data source (server-only) ----
# chain = read Robinhood Chain directly (default). mock = demo data. http = forward /api/* to KERF_API_BASE_URL.
KERF_DATA_SOURCE=chain
# Base URL of the backend that serves /api/markets, /api/routes, /api/quote, ... (see /docs#developers).
# Must NOT point at this app itself.
KERF_API_BASE_URL=
# Optional bearer token sent to the backend. Never exposed to the browser.
KERF_API_KEY=
# RPC provider URL for server-side chain reads (falls back to the public, rate-limited RPC).
KERF_RPC_URL=

# ---- Public (bundled into the browser) ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_EXPLORER_URL=https://robinhoodchain.blockscout.com
NEXT_PUBLIC_X_HANDLE=Kerfworld
# Deployed KerfExecutor (Robinhood Chain, verified on Blockscout).
NEXT_PUBLIC_EXECUTOR_ADDRESS=0x89bdac70A0296dbFf611b6547d50cd29F020BC40
# $KERF contract address, once the token is launched (e.g. via a launchpad). Empty = "soon".
NEXT_PUBLIC_TOKEN_ADDRESS=
